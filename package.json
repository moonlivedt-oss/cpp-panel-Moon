{
  "name": "cpp-docs-panel-project",
  "private": true,
  "version": "3.5.2",
  "description": "Панель документации C++ для VS Code — сборка и тесты",
  "scripts": {
    "package": "node scripts/package-extension.js",
    "package:nosol": "node scripts/package-extension.js --no-solutions",
    "install:vsix": "node scripts/package-extension.js --install",
    "installer": "node scripts/build-installer.js",
    "package:installer": "node scripts/package-extension.js && node scripts/build-installer.js",
    "test": "node --test \"test/*.test.js\"",
    "test:inject": "node --test test/inject.test.js",
    "test:runtime": "node --test test/runtime.test.js",
    "test:run": "node --test test/run.test.js",
    "test:progress": "node --test test/progress.test.js",
    "test:style": "node --test test/style.test.js",
    "test:bridge": "node --test test/bridge.test.js",
    "check": "node --check extension/extension.js && node --check extension/uninstall.js && node --check extension/window-cli.js && node scripts/build-runtime.js --check && node scripts/hash-runtime.js --check && node --check extension/cpp-docs-runtime.js && tsc -p . && node --test \"test/*.test.js\" && node scripts/check-links.js && node scripts/check-consistency.js && node scripts/stamp-ids.js --check && node scripts/perf-budget.js",
    "check:links": "node scripts/check-links.js",
    "check:code": "node scripts/check-code.js",
    "check:challenges": "node scripts/check-challenges.js",
    "check:consistency": "node scripts/check-consistency.js",
    "check:zadachnik": "node scripts/check-zadachnik.js",
    "stamp:ids": "node scripts/stamp-ids.js",
    "lint": "node --stack-size=4000 node_modules/eslint/bin/eslint.js extension scripts test installer/tools playwright.config.js",
    "version:set": "node scripts/set-version.js",
    "hash:runtime": "node scripts/hash-runtime.js",
    "hash:check": "node scripts/hash-runtime.js --check",
    "preview": "node scripts/preview.js",
    "preview:window": "node scripts/preview-window.js",
    "screenshots": "node scripts/preview-window.js docs && node scripts/preview.js docs && node scripts/screenshots.js",
    "embed:logo": "node scripts/embed-logo.js && node scripts/hash-runtime.js",
    "embed:stickers": "node scripts/embed-stickers.js && node scripts/hash-runtime.js",
    "embed:ui-icons": "node scripts/embed-ui-icons.js && node scripts/hash-runtime.js",
    "optimize:images": "python scripts/optimize-images.py && node scripts/embed-stickers.js && node scripts/build-runtime.js && node scripts/hash-runtime.js",
    "docs:slova": "node scripts/gen-snippets-doc.js",
    "test:panel": "node --test test/panel.test.js",
    "build:runtime": "node scripts/build-runtime.js && node scripts/hash-runtime.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-include=\"extension/**/*.js\" --test-coverage-exclude=\"extension/runtime/**\" --test-coverage-exclude=\"extension/cpp-docs-runtime.js\" \"test/*.test.js\"",
    "test:smoke": "node --test test/smoke.test.js",
    "check:perf": "node scripts/perf-budget.js",
    "typecheck": "tsc -p .",
    "dev": "node scripts/dev.js",
    "test:vscode": "node test/vscode/run.js",
    "test:visual": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
