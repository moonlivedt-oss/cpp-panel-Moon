{
  // Проверка типов JS-кода расширения по JSDoc (npm run typecheck, и в CI). Ничего не компилирует:
  // noEmit. TypeScript — только dev-инструмент, в поставку не попадает.
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "types": ["node", "vscode"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["extension/extension.js", "extension/uninstall.js", "extension/lib/**/*.js"]
}
